# Unity3D generated meta files that are not part of the package
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash / addressable reports
sysinfo.txt
*.apk
*.aab
*.unitypackage
crashlytics-build.properties

# OS
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Secrets: never commit keystore passwords or local launch scripts
*.keystore
*.jks
local-secrets.bat
