# ---------------------------------------------------------------------------
# Unity Toolbox
#
# This repository is a UPM package, not a Unity project. If you open it in the
# Unity Editor for testing, the folders below will appear and must stay out of
# version control.
# ---------------------------------------------------------------------------

# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Generated by Unity Package Manager / IDE integrations
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
